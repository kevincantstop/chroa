<Styles xmlns="https://github.com/avaloniaui">

	<Style Selector="TextBlock.head">
		<Setter Property="Foreground" Value="#B0FFFFFF" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="8,0,0,0" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<Style Selector="TextBlock.cell">
		<Setter Property="Foreground" Value="#E0E0E0" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="8,0,0,0" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<Style Selector="Grid.row">
		<Setter Property="Background" Value="Transparent" />
	</Style>

	<Style Selector="Grid.row:pointerover">
		<Setter Property="Background" Value="#1AFFFFFF" />
	</Style>

	<Style Selector="Grid.row.playing">
		<Setter Property="Background" Value="#33FFFFFF" />
	</Style>

	<Style Selector="Grid.row.playing:pointerover">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>

	<Style Selector="Button.action">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="28" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="Button.action.close">
		<Setter Property="Width" Value="32" />
		<Setter Property="Height" Value="32" />
		<Setter Property="CornerRadius" Value="16" />
	</Style>

	<Style Selector="Button.action:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>

	<Style Selector="Button.action:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="#66FFFFFF" />
	</Style>

	<Style Selector="Button.remove:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="#33FF6B6B" />
	</Style>

	<Style Selector="Button.remove:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="#55FF6B6B" />
	</Style>

	<Style Selector="TextBlock.count">
		<Setter Property="Foreground" Value="#B0FFFFFF" />
		<Setter Property="FontSize" Value="14" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="16,0,0,0" />
	</Style>

	<Style Selector="Button.batch">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Width" Value="28" />
		<Setter Property="Height" Value="28" />
		<Setter Property="CornerRadius" Value="14" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="HorizontalContentAlignment" Value="Center" />
		<Setter Property="VerticalContentAlignment" Value="Center" />
	</Style>

	<Style Selector="Button.batch:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="#33FF6B6B" />
	</Style>

	<Style Selector="Button.batch:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="#55FF6B6B" />
	</Style>

	<Style Selector="CheckBox.check">
		<Setter Property="MinWidth" Value="0" />
		<Setter Property="MinHeight" Value="0" />
		<Setter Property="Padding" Value="0" />
		<Setter Property="Cursor" Value="Hand" />
		<Setter Property="HorizontalAlignment" Value="Center" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="CheckBox.check /template/ Border#NormalRectangle">
		<Setter Property="Width" Value="14" />
		<Setter Property="Height" Value="14" />
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderBrush" Value="#55FFFFFF" />
		<Setter Property="BorderThickness" Value="1.5" />
		<Setter Property="CornerRadius" Value="2.5" />
	</Style>

	<Style Selector="CheckBox.check:pointerover /template/ Border#NormalRectangle">
		<Setter Property="BorderBrush" Value="#88FFFFFF" />
	</Style>

	<Style Selector="CheckBox.check:checked /template/ Border#NormalRectangle">
		<Setter Property="Background" Value="#E0E0E0" />
		<Setter Property="BorderBrush" Value="#E0E0E0" />
	</Style>

	<Style Selector="CheckBox.check:indeterminate /template/ Border#NormalRectangle">
		<Setter Property="Background" Value="#E0E0E0" />
		<Setter Property="BorderBrush" Value="#E0E0E0" />
	</Style>

	<Style Selector="CheckBox.check /template/ Path#CheckGlyph">
		<Setter Property="Width" Value="8" />
		<Setter Property="Height" Value="8" />
		<Setter Property="Fill" Value="#101010" />
	</Style>
</Styles>
