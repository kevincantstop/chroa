<chroa:PluginWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chroa="clr-namespace:ChroaVideoPlayer.Core.Plugin.UI;assembly=ChroaVideoPlayer.Core"
                    xmlns:playlist="clr-namespace:ChroaVideoPlayer.Plugins.Playlist"
                    xmlns:core="clr-namespace:ChroaVideoPlayer.Core.UI;assembly=ChroaVideoPlayer.Core"
                    x:Class="ChroaVideoPlayer.Plugins.Playlist.PlaylistPluginWindow"
                    Title="Playlist"
                    Width="580"
                    Height="770"
					MinWidth="530"
					MinHeight="700"
                    InitialDockSide="Left"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="OnFileDragOver"
                    DragDrop.Drop="OnFileDrop">
	<chroa:PluginWindow.Styles>
		<StyleInclude Source="avares://ChroaVideoPlayer.Plugins.Playlist/Styles/PlaylistWindow.axaml" />
	</chroa:PluginWindow.Styles>

	<Grid Margin="12" RowDefinitions="Auto,Auto,*">
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Text="Playlist"
			           FontSize="16"
			           Foreground="White"
			           VerticalAlignment="Center" />

			<core:SVGIconButton Grid.Column="1"
			                    Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/close.svg"
			                    ButtonSize="32"
			                    IconSize="16"
			                    HorizontalAlignment="Right"
			                    VerticalAlignment="Center"
			                    Click="OnCloseClick"
			                    ToolTip.Tip="Close" />
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,10">
			<StackPanel Grid.Column="0"
			            Orientation="Horizontal"
			            Spacing="8"
			            HorizontalAlignment="Left"
			            VerticalAlignment="Center">
				<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/plus.svg"
				                    ButtonSize="32"
				                    IconSize="20"
				                    VerticalAlignment="Center"
				                    Click="OnAddClick"
				                    ToolTip.Tip="Add to playlist" />

				<core:SVGIconButton x:Name="AutoPlayButton"
				                    Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/play-next.svg"
				                    ButtonSize="32"
				                    IconSize="20"
				                    VerticalAlignment="Center"
				                    Click="OnAutoPlayClick"
				                    ToolTip.Tip="Play the next video automatically" />

				<core:InputBox x:Name="SearchInput"
				               Classes="search"
				               Width="200"
				               PlaceholderText="Search"
				               VerticalAlignment="Center"
				               TextChanged="OnSearchChanged">
					<TextBox.InnerLeftContent>
						<core:SvgIcon Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/search.svg"
						              IconSize="14"
						              Foreground="#B0FFFFFF"
						              Margin="8,0,0,0" />
					</TextBox.InnerLeftContent>
				</core:InputBox>
			</StackPanel>

			<core:SVGIconButton Grid.Column="1"
			                    x:Name="DeleteSelectedButton"
			                    Classes="remove"
			                    Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/trash.svg"
			                    ButtonSize="28"
			                    IconSize="18"
			                    Foreground="#FF6B6B"
			                    VerticalAlignment="Center"
			                    IsVisible="False"
			                    Click="OnDeleteSelectedClick"
			                    ToolTip.Tip="Remove selected videos" />

			<TextBlock Grid.Column="2"
			           x:Name="CountText"
			           Classes="count" />
		</Grid>

		<playlist:PlaylistGrid Grid.Row="2" x:Name="RowList" />
	</Grid>
</chroa:PluginWindow>
