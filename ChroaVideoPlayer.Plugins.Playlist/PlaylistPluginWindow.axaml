<chroa:PluginWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chroa="clr-namespace:ChroaVideoPlayer.Core.Plugin.UI;assembly=ChroaVideoPlayer.Core"
                    xmlns:playlist="clr-namespace:ChroaVideoPlayer.Plugins.Playlist"
                    xmlns:core="clr-namespace:ChroaVideoPlayer.Core.UI;assembly=ChroaVideoPlayer.Core"
                    x:Class="ChroaVideoPlayer.Plugins.Playlist.PlaylistPluginWindow"
                    Title="Playlist"
                    Width="680"
                    Height="780"
                    InitialDockSide="Left">
	<chroa:PluginWindow.Styles>
		<StyleInclude Source="avares://ChroaVideoPlayer.Plugins.Playlist/Styles/PlaylistWindow.axaml" />
	</chroa:PluginWindow.Styles>

	<Grid Margin="12" RowDefinitions="Auto,Auto,*">
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Text="Playlist"
			           FontSize="16"
			           Foreground="White"
			           VerticalAlignment="Center" />

			<core:SVGIconButton Grid.Column="1"
			                    Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/close.svg"
			                    ButtonSize="32"
			                    IconSize="16"
			                    HorizontalAlignment="Right"
			                    VerticalAlignment="Center"
			                    Click="OnCloseClick"
			                    ToolTip.Tip="Close" />
		</Grid>

		<Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,10">
			<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/plus.svg"
			                    ButtonSize="32"
			                    IconSize="20"
			                    HorizontalAlignment="Left"
			                    VerticalAlignment="Center"
			                    Click="OnAddClick"
			                    ToolTip.Tip="Add to playlist" />

			<core:SVGIconButton Grid.Column="1"
			                    x:Name="DeleteSelectedButton"
			                    Classes="remove"
			                    Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/trash.svg"
			                    ButtonSize="28"
			                    IconSize="18"
			                    Foreground="#FF6B6B"
			                    VerticalAlignment="Center"
			                    IsVisible="False"
			                    Click="OnDeleteSelectedClick"
			                    ToolTip.Tip="Remove selected videos" />

			<TextBlock Grid.Column="2"
			           x:Name="CountText"
			           Classes="count" />
		</Grid>

		<ScrollViewer Grid.Row="2"
		              HorizontalScrollBarVisibility="Auto"
		              VerticalScrollBarVisibility="Auto">
			<Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,*">
				<Grid Grid.Row="0" Height="32" Background="#1AFFFFFF">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="28" />
						<ColumnDefinition Width="80" SharedSizeGroup="Duration" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="180" SharedSizeGroup="Name" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="260" SharedSizeGroup="Path" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="68" />
					</Grid.ColumnDefinitions>

					<CheckBox Grid.Column="0"
					          x:Name="SelectAllBox"
					          Classes="check"
					          IsThreeState="True"
					          IsChecked="False"
					          Click="OnSelectAllClick"
					          ToolTip.Tip="Select all" />
					<TextBlock Grid.Column="1" Classes="head" Text="Duration" />
					<GridSplitter Grid.Column="2" Background="Transparent" ResizeDirection="Columns" />
					<TextBlock Grid.Column="3" Classes="head" Text="Name" />
					<GridSplitter Grid.Column="4" Background="Transparent" ResizeDirection="Columns" />
					<TextBlock Grid.Column="5" Classes="head" Text="Path" />
				</Grid>

				<ItemsControl Grid.Row="1" x:Name="ItemHost">
					<ItemsControl.ContextMenu>
						<playlist:PlaylistEntryMenu x:Name="RowMenu"
						                            PlayRequested="OnMenuPlayRequested"
						                            RevealRequested="OnMenuRevealRequested"
						                            DeleteRequested="OnMenuDeleteRequested" />
					</ItemsControl.ContextMenu>

					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="playlist:PlaylistEntry">
							<Grid Classes="row interactive"
							      Height="32"
							      Classes.playing="{Binding IsPlaying}"
							      Classes.selected="{Binding IsSelected}"
							      ToolTip.Tip="Double click to play"
							      DoubleTapped="OnRowDoubleTapped"
							      ContextRequested="OnRowContextRequested">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="28" />
									<ColumnDefinition Width="80" SharedSizeGroup="Duration" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="180" SharedSizeGroup="Name" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="260" SharedSizeGroup="Path" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="68" />
								</Grid.ColumnDefinitions>

								<Border Grid.ColumnSpan="8"
								        Width="2"
								        HorizontalAlignment="Left"
								        Background="#E0E0E0"
								        IsVisible="{Binding IsPlaying}" />

								<CheckBox Grid.Column="0"
								          Classes="check"
								          IsChecked="{Binding IsSelected}"
								          Click="OnRowCheckClick" />

								<TextBlock Grid.Column="1" Classes="cell" Text="{Binding DurationText}" />
								<TextBlock Grid.Column="3" Classes="cell" Text="{Binding Title}" />
								<TextBlock Grid.Column="5" Classes="cell" Text="{Binding Path}" ToolTip.Tip="{Binding Path}" />

								<StackPanel Grid.Column="7"
								            Orientation="Horizontal"
								            Spacing="6"
								            VerticalAlignment="Center">
									<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/folder.svg"
									                    ButtonSize="28"
									                    IconSize="14"
									                    VerticalAlignment="Center"
									                    Click="OnRevealClick"
									                    ToolTip.Tip="Show in folder" />

									<core:SVGIconButton Classes="remove"
									                    Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/trash.svg"
									                    ButtonSize="28"
									                    IconSize="14"
									                    Foreground="#FF6B6B"
									                    VerticalAlignment="Center"
									                    Click="OnDeleteClick"
									                    ToolTip.Tip="Remove from playlist" />
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Grid>
		</ScrollViewer>
	</Grid>
</chroa:PluginWindow>
