<chroa:PluginWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chroa="clr-namespace:ChroaVideoPlayer.Core.Plugin.UI;assembly=ChroaVideoPlayer.Core"
                    xmlns:playlist="clr-namespace:ChroaVideoPlayer.Plugins.Playlist"
                    xmlns:core="clr-namespace:ChroaVideoPlayer.Core.UI;assembly=ChroaVideoPlayer.Core"
                    x:Class="ChroaVideoPlayer.Plugins.Playlist.PlaylistPluginWindow"
                    Title="Playlist"
                    Width="460"
                    Height="380"
                    InitialDockSide="Left">
	<chroa:PluginWindow.Styles>
		<StyleInclude Source="avares://ChroaVideoPlayer.Plugins.Playlist/Styles/PlaylistWindow.axaml" />
	</chroa:PluginWindow.Styles>

	<Grid Margin="12" RowDefinitions="Auto,*">
		<Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" Margin="0,0,0,8">
			<TextBlock Text="Playlist"
			           FontSize="16"
			           Foreground="White"
			           VerticalAlignment="Center" />

			<Button Grid.Column="2"
			        x:Name="DeleteSelectedButton"
			        Classes="batch"
			        IsVisible="False"
			        Click="OnDeleteSelectedClick"
			        ToolTip.Tip="Remove selected videos">
				<StackPanel Orientation="Horizontal" Spacing="6">
					<Path Data="M10 11v6 M14 11v6 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
					      Stroke="#FF6B6B"
					      StrokeThickness="2"
					      StrokeLineCap="Round"
					      StrokeJoin="Round"
					      Stretch="Uniform"
					      Width="12"
					      Height="12" />
					<TextBlock Text="Delete"
					           FontSize="12"
					           Foreground="#FF6B6B"
					           VerticalAlignment="Center" />
				</StackPanel>
			</Button>

			<TextBlock Grid.Column="3"
			           x:Name="CountText"
			           Classes="count" />

			<Button Grid.Column="4"
			        Classes="action"
			        HorizontalAlignment="Right"
			        Click="OnCloseClick"
			        ToolTip.Tip="Close">
				<core:SvgIcon Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/close.svg"
				              IconSize="14"
				              Foreground="#E0E0E0" />
			</Button>
		</Grid>

		<ScrollViewer Grid.Row="1"
		              HorizontalScrollBarVisibility="Auto"
		              VerticalScrollBarVisibility="Auto">
			<Grid Grid.IsSharedSizeScope="True" RowDefinitions="Auto,*">
				<Grid Grid.Row="0" Height="28" Background="#1AFFFFFF">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="28" />
						<ColumnDefinition Width="80" SharedSizeGroup="Duration" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="180" SharedSizeGroup="Name" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="260" SharedSizeGroup="Path" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="60" />
					</Grid.ColumnDefinitions>

					<CheckBox Grid.Column="0"
					          x:Name="SelectAllBox"
					          Classes="check"
					          IsThreeState="True"
					          IsChecked="False"
					          Click="OnSelectAllClick"
					          ToolTip.Tip="Select all" />
					<TextBlock Grid.Column="1" Classes="head" Text="Duration" />
					<GridSplitter Grid.Column="2" Background="Transparent" ResizeDirection="Columns" />
					<TextBlock Grid.Column="3" Classes="head" Text="Name" />
					<GridSplitter Grid.Column="4" Background="Transparent" ResizeDirection="Columns" />
					<TextBlock Grid.Column="5" Classes="head" Text="Path" />
				</Grid>

				<ItemsControl Grid.Row="1" x:Name="ItemHost">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="playlist:PlaylistEntry">
							<Grid Classes="row interactive"
							      Height="28"
							      Classes.playing="{Binding IsPlaying}"
							      ToolTip.Tip="Double click to play"
							      DoubleTapped="OnRowDoubleTapped">
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="28" />
									<ColumnDefinition Width="80" SharedSizeGroup="Duration" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="180" SharedSizeGroup="Name" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="260" SharedSizeGroup="Path" />
									<ColumnDefinition Width="6" />
									<ColumnDefinition Width="60" />
								</Grid.ColumnDefinitions>

								<Border Grid.ColumnSpan="8"
								        Width="2"
								        HorizontalAlignment="Left"
								        Background="#E0E0E0"
								        IsVisible="{Binding IsPlaying}" />

								<CheckBox Grid.Column="0"
								          Classes="check"
								          IsChecked="{Binding IsSelected}"
								          Click="OnRowCheckClick" />

								<TextBlock Grid.Column="1" Classes="cell" Text="{Binding DurationText}" />
								<TextBlock Grid.Column="3" Classes="cell" Text="{Binding Title}" />
								<TextBlock Grid.Column="5" Classes="cell" Text="{Binding Path}" ToolTip.Tip="{Binding Path}" />

								<StackPanel Grid.Column="7"
								            Orientation="Horizontal"
								            Spacing="6"
								            VerticalAlignment="Center">
									<Button Classes="action"
									        Click="OnRevealClick"
									        ToolTip.Tip="Show in folder">
										<Path Data="M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z"
										      Stroke="#E0E0E0"
										      StrokeThickness="2"
										      StrokeLineCap="Round"
										      StrokeJoin="Round"
										      Stretch="Uniform"
										      Width="14"
										      Height="14" />
									</Button>

									<Button Classes="action remove"
									        Click="OnDeleteClick"
									        ToolTip.Tip="Remove from playlist">
										<Path Data="M10 11v6 M14 11v6 M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6 M3 6h18 M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"
										      Stroke="#FF6B6B"
										      StrokeThickness="2"
										      StrokeLineCap="Round"
										      StrokeJoin="Round"
										      Stretch="Uniform"
										      Width="14"
										      Height="14" />
									</Button>
								</StackPanel>
							</Grid>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</Grid>
		</ScrollViewer>
	</Grid>
</chroa:PluginWindow>
