<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:playlist="clr-namespace:ChroaVideoPlayer.Plugins.Playlist"
             xmlns:core="clr-namespace:ChroaVideoPlayer.Core.UI;assembly=ChroaVideoPlayer.Core"
             x:Class="ChroaVideoPlayer.Plugins.Playlist.PlaylistGrid">
	<core:ChroaVirtualList x:Name="ItemHost">
		<core:ChroaVirtualList.ContextMenu>
			<playlist:PlaylistEntryMenu x:Name="RowMenu"
			                            PlayRequested="OnMenuPlayRequested"
			                            RevealRequested="OnMenuRevealRequested"
			                            DeleteRequested="OnMenuDeleteRequested" />
		</core:ChroaVirtualList.ContextMenu>

		<core:ChroaVirtualList.Header>
			<Grid Height="32" Background="#1AFFFFFF">
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="28" />
					<ColumnDefinition Width="80" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="180" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="260" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="90" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="70" />
					<ColumnDefinition Width="6" />
					<ColumnDefinition Width="132" />
				</Grid.ColumnDefinitions>

				<CheckBox Grid.Column="0"
				          x:Name="SelectAllBox"
				          Classes="check"
				          IsThreeState="True"
				          IsChecked="False"
				          Click="OnSelectAllClick"
				          ToolTip.Tip="Select all" />
				<TextBlock Grid.Column="1" Classes="head" Text="Duration" />
				<GridSplitter Grid.Column="2" Background="Transparent" ResizeDirection="Columns" />
				<TextBlock Grid.Column="3" Classes="head" Text="Name" />
				<GridSplitter Grid.Column="4" Background="Transparent" ResizeDirection="Columns" />
				<TextBlock Grid.Column="5" Classes="head" Text="Path" />
				<GridSplitter Grid.Column="6" Background="Transparent" ResizeDirection="Columns" />
				<TextBlock Grid.Column="7" Classes="head" Text="Last played" />
				<GridSplitter Grid.Column="8" Background="Transparent" ResizeDirection="Columns" />
				<TextBlock Grid.Column="9" Classes="head" Text="Played" />
			</Grid>
		</core:ChroaVirtualList.Header>

		<core:ChroaVirtualList.ItemTemplate>
			<DataTemplate x:DataType="playlist:PlaylistEntry">
				<Grid Classes="row interactive"
				      Height="32"
				      Classes.playing="{Binding IsPlaying}"
				      Classes.selected="{Binding IsSelected}"
				      Classes.current="{Binding IsCurrent}"
				      Classes.missing="{Binding IsMissing}"
				      ToolTip.Tip="{Binding RowTip}"
				      PointerPressed="OnRowPointerPressed"
				      ContextRequested="OnRowContextRequested"
				      DragDrop.AllowDrop="True"
				      PointerMoved="OnRowPointerMoved"
				      DragDrop.DragOver="OnRowDragOver"
				      DragDrop.DragLeave="OnRowDragLeave"
				      DragDrop.Drop="OnRowDrop">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="28" />
						<ColumnDefinition Width="80" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="180" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="260" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="90" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="70" />
						<ColumnDefinition Width="6" />
						<ColumnDefinition Width="132" />
					</Grid.ColumnDefinitions>

					<Border Grid.ColumnSpan="12"
					        Width="2"
					        HorizontalAlignment="Left"
					        Background="#E0E0E0"
					        IsVisible="{Binding IsPlaying}" />

					<CheckBox Grid.Column="0"
					          Classes="check"
					          IsChecked="{Binding IsSelected}"
					          Click="OnRowCheckClick" />

					<TextBlock Grid.Column="1" Classes="cell" Text="{Binding DurationText}" />
					<TextBlock Grid.Column="3" Classes="cell" Text="{Binding Title}" />
					<Grid Grid.Column="5" ColumnDefinitions="Auto,*">
						<core:SvgIcon Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/close.svg"
						              IconSize="12"
						              Foreground="#FF6B6B"
						              Margin="8,0,0,0"
						              HorizontalAlignment="Left"
						              VerticalAlignment="Center"
						              IsVisible="{Binding IsMissing}" />
						<TextBlock Grid.Column="1" Classes="cell" Text="{Binding Path}" ToolTip.Tip="{Binding Path}" />
					</Grid>

					<TextBlock Grid.Column="7" Classes="cell" Text="{Binding PlayedDurationText}" />
					<TextBlock Grid.Column="9" Classes="cell"
					           Classes.complete="{Binding IsCompleted}"
					           Text="{Binding PlayedPercentText}" />

					<StackPanel Grid.Column="11"
					            Orientation="Horizontal"
					            Spacing="6"
					            VerticalAlignment="Center">
						<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/arrow-up.svg"
						                    ButtonSize="28"
						                    IconSize="14"
						                    VerticalAlignment="Center"
						                    IsEnabled="{Binding CanMoveUp}"
						                    Click="OnMoveUpClick"
						                    ToolTip.Tip="Move up" />

						<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/arrow-down.svg"
						                    ButtonSize="28"
						                    IconSize="14"
						                    VerticalAlignment="Center"
						                    IsEnabled="{Binding CanMoveDown}"
						                    Click="OnMoveDownClick"
						                    ToolTip.Tip="Move down" />

						<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/folder.svg"
						                    ButtonSize="28"
						                    IconSize="14"
						                    VerticalAlignment="Center"
						                    Click="OnRevealClick"
						                    ToolTip.Tip="Show in folder" />

						<core:SVGIconButton Classes="remove"
						                    Icon="avares://ChroaVideoPlayer.Plugins.Playlist/Icons/trash.svg"
						                    ButtonSize="28"
						                    IconSize="14"
						                    Foreground="#FF6B6B"
						                    VerticalAlignment="Center"
						                    Click="OnDeleteClick"
						                    ToolTip.Tip="Remove from playlist" />
					</StackPanel>

					<Border Grid.ColumnSpan="12"
					        Height="2"
					        VerticalAlignment="Top"
					        Background="#E0E0E0"
					        IsVisible="{Binding IsDropBefore}" />

					<Border Grid.ColumnSpan="12"
					        Height="2"
					        VerticalAlignment="Bottom"
					        Background="#E0E0E0"
					        IsVisible="{Binding IsDropAfter}" />
				</Grid>
			</DataTemplate>
		</core:ChroaVirtualList.ItemTemplate>
	</core:ChroaVirtualList>
</UserControl>
