<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mpv="clr-namespace:HanumanInstitute.LibMpv.Avalonia;assembly=HanumanInstitute.LibMpv.Avalonia"
             xmlns:vm="clr-namespace:ChroaVideoPlayer.ViewModels"
             xmlns:chroa="clr-namespace:ChroaVideoPlayer.Controls"
             x:Class="ChroaVideoPlayer.Controls.MpvVideoPlayer"
             x:DataType="vm:VideoPlayerViewModel">
	<Grid>
		<mpv:MpvView x:Name="MpvViewControl" MpvContext="{Binding Mpv.ViewContext}" Renderer="OpenGl" />

		<Border Classes="overlay bottom" VerticalAlignment="Bottom"
		        Margin="24,0,24,28"
		        IsVisible="{Binding HasVideo}">
			<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<chroa:SVGIconButton x:Name="PlayButton"
					                     Icon="/Icons/play.svg"
					                     ButtonShape="Circle" ButtonSize="48" IconSize="24"
					                     Click="OnPlayPauseClick" />

					<chroa:SVGIconButton x:Name="PauseButton"
					                     Icon="/Icons/pause.svg"
					                     ButtonShape="Circle" ButtonSize="48" IconSize="24"
					                     Click="OnPlayPauseClick" />
				</StackPanel>

				<TextBlock x:Name="PositionText" Grid.Column="1" Classes="time" />

				<chroa:DragBar x:Name="SeekBar" Grid.Column="2" />

				<TextBlock x:Name="DurationText" Grid.Column="3" Classes="time" />

				<chroa:SVGIconButton x:Name="VolumeButton" Grid.Column="4"
				                     Icon="/Icons/volume-2.svg"
				                     IsEnabled="{Binding HasAudioTrack}"
				                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
				                     VerticalAlignment="Center"
				                     Click="OnMuteClick" />

				<chroa:SVGIconButton x:Name="MutedButton" Grid.Column="4"
				                     Icon="/Icons/volume-x.svg"
				                     IsEnabled="{Binding HasAudioTrack}"
				                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
				                     VerticalAlignment="Center"
				                     Click="OnMuteClick" />

				<chroa:DragBar x:Name="VolumeBar" Grid.Column="5" Width="90"
				               Margin="12,0,0,0"
				               IsEnabled="{Binding HasAudioTrack}" />
			</Grid>
		</Border>
	</Grid>
</UserControl>
