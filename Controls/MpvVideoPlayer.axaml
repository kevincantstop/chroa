<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mpv="clr-namespace:HanumanInstitute.LibMpv.Avalonia;assembly=HanumanInstitute.LibMpv.Avalonia"
             xmlns:vm="clr-namespace:ChroaVideoPlayer.ViewModels"
             xmlns:chroa="clr-namespace:ChroaVideoPlayer.Controls"
             x:Class="ChroaVideoPlayer.Controls.MpvVideoPlayer"
             x:DataType="vm:VideoPlayerViewModel">
	<Grid PointerPressed="OnPlayerPointerPressed">
		<mpv:MpvView x:Name="MpvViewControl" MpvContext="{Binding Mpv.ViewContext}" Renderer="OpenGl" />

		<Grid VerticalAlignment="Bottom" RowDefinitions="Auto,Auto">
			<chroa:VideoCaption Grid.Row="0"
			                    Player="{Binding Mpv}"
			                    IsVisible="{Binding IsSubtitleMenuOpen}" />

			<chroa:PlaybackSpeed x:Name="SpeedMenu" Grid.Row="0"
			                     IsVisible="{Binding IsSpeedMenuOpen}" />

			<Border Grid.Row="1" Classes="overlay bottom"
			        Background="#99000000"
					BoxShadow="0 -6 16 0 #80000000"
			        Padding="24,18"
			        IsVisible="{Binding HasVideo}">
				<Grid RowDefinitions="Auto,Auto">
					<Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
						<TextBlock x:Name="PositionText" Grid.Column="0" Classes="time" Margin="0,0,12,0" />

						<chroa:DragBar x:Name="SeekBar" Grid.Column="1" />

						<TextBlock x:Name="DurationText" Grid.Column="2" Classes="time" Margin="12,0,0,0" />
					</Grid>

					<Grid Grid.Row="1" ColumnDefinitions="*,Auto,*" Margin="0,4,0,0">
						<StackPanel Grid.Column="0" Orientation="Horizontal"
						            HorizontalAlignment="Left" VerticalAlignment="Center">
							<chroa:SVGIconButton x:Name="CopyFrameButton"
							                     Icon="/Icons/camera.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     Margin="-11,0,8,0"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Copy frame to clipboard"
							                     Click="OnCopyFrameClick" />

							<chroa:SVGIconButton x:Name="CopiedButton"
							                     Icon="/Icons/check.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     Margin="-11,0,8,0"
							                     VerticalAlignment="Center"
							                     IsVisible="False"
							                     ToolTip.Tip="Copy frame"
							                     Click="OnCopyFrameClick" />

							<chroa:SVGIconButton x:Name="SpeedButton"
							                     Icon="/Icons/gauge.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Playback speed"
							                     Click="OnSpeedClick" />

							<TextBlock x:Name="SpeedText" Classes="speedLabel" IsVisible="False" />
						</StackPanel>

						<StackPanel Grid.Column="1" Orientation="Horizontal">
							<chroa:SVGIconButton x:Name="RewindButton"
							                     Icon="/Icons/rewind.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     Margin="0,0,8,0"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Back 5 seconds"
							                     Click="OnRewindClick" />

							<chroa:SVGIconButton x:Name="PlayButton"
							                     Icon="/Icons/play.svg"
							                     ButtonShape="Circle" ButtonSize="48" IconSize="24"
							                     ToolTip.Tip="Play"
							                     Click="OnPlayPauseClick" />

							<chroa:SVGIconButton x:Name="PauseButton"
							                     Icon="/Icons/pause.svg"
							                     ButtonShape="Circle" ButtonSize="48" IconSize="24"
							                     ToolTip.Tip="Pause"
							                     Click="OnPlayPauseClick" />

							<chroa:SVGIconButton x:Name="ForwardButton"
							                     Icon="/Icons/fast-forward.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     Margin="8,0,0,0"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Forward 5 seconds"
							                     Click="OnForwardClick" />
						</StackPanel>

						<StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
							<chroa:SVGIconButton x:Name="VolumeButton"
							                     Icon="/Icons/volume-2.svg"
							                     IsEnabled="{Binding HasAudioTrack}"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Mute"
							                     Click="OnMuteClick" />

							<chroa:SVGIconButton x:Name="MutedButton"
							                     Icon="/Icons/volume-x.svg"
							                     IsEnabled="{Binding HasAudioTrack}"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Unmute"
							                     Click="OnMuteClick" />

							<chroa:DragBar x:Name="VolumeBar" Width="90"
							               Margin="3,0,0,0"
							               IsEnabled="{Binding HasAudioTrack}" />

							<chroa:SVGIconButton x:Name="SubtitleButton"
							                     Icon="/Icons/closed-caption.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     Margin="12,0,0,0"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Subtitles"
							                     Click="OnSubtitleClick" />

							<chroa:SVGIconButton x:Name="FullScreenButton"
							                     Icon="/Icons/maximize.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     Margin="0,0,-12,0"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Full screen"
							                     Click="OnFullScreenClick" />

							<chroa:SVGIconButton x:Name="FullScreenExitButton"
							                     Icon="/Icons/minimize.svg"
							                     ButtonShape="Circle" ButtonSize="40" IconSize="20"
							                     Margin="0,0,-12,0"
							                     VerticalAlignment="Center"
							                     ToolTip.Tip="Exit full screen"
							                     Click="OnFullScreenClick" />
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
		</Grid>
	</Grid>
</UserControl>