<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HanumanInstitute.LibMpv" Version="0.10.1" />
    <PackageReference Include="HanumanInstitute.LibMpv.Avalonia" Version="0.10.1" />
  </ItemGroup>

  <!-- LibMpv only searches MpvApi.RootPath for libmpv-2.dll, whose default is the folder holding the
       exe. The DLL stays in a native\ subfolder in the output, and Program.cs points RootPath at it.
       (No Link metadata, so MSBuild keeps the native\ folder in the output path.) -->
  <ItemGroup>
    <None Include="native\libmpv-2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Controls\" />
  </ItemGroup>

  <!-- 图标以 Avalonia 资源形式打包。Avalonia 默认只把 *.axaml / *.paml 作为资源
       （见 AvaloniaBuildTasks.props 里的默认 glob），其它文件（.svg / .png）必须显式声明，
       否则运行时 AssetLoader 找不到 —— 表现为图标空白，只在调试输出里有一条提示。 -->
  <ItemGroup>
    <AvaloniaResource Include="Icons\**" />
  </ItemGroup>
</Project>
