<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mpv="clr-namespace:HanumanInstitute.LibMpv.Avalonia;assembly=HanumanInstitute.LibMpv.Avalonia"
        xmlns:vm="clr-namespace:ChroaVideoPlayer.ViewModels"
        xmlns:chroa="clr-namespace:ChroaVideoPlayer.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ChroaVideoPlayer.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ChroaVideoPlayer"
        Width="1280" Height="720"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="True"
        Background="#0A0A0B">
	<!-- 浮层的样式（淡入淡出 + 触发条件）已分离到 Styles/WindowChrome.axaml，
	     通过 App.axaml 的 StyleInclude 引入；这里只负责结构与行为。

	     整窗都能拖动窗口：在手柄里靠"源元素是否有 Button 祖先"放行按钮，
	     靠 e.Handled 放行四角热区。视频区域按下去也会走这里。 -->
	<Grid x:Name="RootGrid" Classes="root" Background="Transparent"
	      PointerPressed="OnRootPointerPressed"
	      DragDrop.AllowDrop="True"
	      DragDrop.DragOver="OnDragOver"
	      DragDrop.Drop="OnDrop">

		<mpv:MpvView MpvContext="{Binding Mpv.ViewContext}" Renderer="OpenGl" />

		<!-- 空状态入口：还没有任何文件被加载时，屏幕中央显示 Load Video。
		     放 MpvView 之后、控制带之前：压在视频上（正常窗口尺寸下不与控制条重叠）。
		     它是个 Button，所以根上的"拖动窗口"会自动放行 ——
		     OnRootPointerPressed 里既有 e.Handled 判断，也有 Button 祖先判断，不用额外处理。 -->
		<Button Classes="loadVideo"
		        HorizontalAlignment="Center" VerticalAlignment="Center"
		        Cursor="Hand"
		        IsVisible="{Binding ShowLoadVideo}"
		        Click="OnLoadVideoClick">
			<StackPanel Orientation="Horizontal" Spacing="10">
				<chroa:SvgIcon Icon="/Icons/film.svg" IconSize="20" VerticalAlignment="Center" />
				<TextBlock Text="Load Video" VerticalAlignment="Center" />
			</StackPanel>
		</Button>

		<!-- 顶部控制带：刻意不使用 WindowDecorationProperties.ElementRole。
		     那套机制会把整条区域变成 Windows 的非客户区（标题栏），导致：
		       · Avalonia 的指针悬停追踪失效 → 整条把自己淡出成隐形，按钮点不到
		       · 光标归属权交给 OS → 永远是箭头，Cursor="Hand" 无效
		     所以拖动与双击最大化改为自己实现，见 MainWindow.axaml.cs。 -->
		<Border Classes="overlay top" VerticalAlignment="Top" Background="Transparent"
		        DoubleTapped="OnChromeDoubleTapped">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<chroa:SVGIconButton Icon="/Icons/minus.svg"
									 ButtonShape="Square"
									 ButtonSize="48"
									 IconSize="24"
									 Click="OnMinimizeClick" />

				<chroa:SVGIconButton Icon="/Icons/square.svg"
									 ButtonSize="48"
									 IconSize="24"
									 ButtonShape="Square"
									 Click="OnMaximizeClick" />

				<chroa:SVGIconButton Icon="/Icons/x.svg"
									 ButtonSize="48"
									 IconSize="24"
									 ButtonShape="Square"
									 Click="OnCloseClick" />
			</StackPanel>
		</Border>

		<!-- 底部控制条：显隐完全交给 Styles/WindowChrome.axaml（指针在窗口内任意位置就显示） -->
		<Border Classes="overlay bottom" VerticalAlignment="Bottom"
		        Margin="24,0,24,28"
		        IsVisible="{Binding HasVideo}">
			<!-- 一行：[播放/暂停] [当前时间] [======进度条======] [总时长] [音量图标] [音量条]
			     进度条那列是 *，窗口变宽变窄它都跟着变。 -->
			<Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto">
				<StackPanel Grid.Column="0" Orientation="Horizontal">
					<!-- 暂停中或已播完 → 显示"播放"图标，点它继续 / 从头重播 -->
					<chroa:SVGIconButton Icon="/Icons/play.svg"
										 ButtonShape="Circle" ButtonSize="48" IconSize="24"
										 IsVisible="{Binding ShowPlayIcon}"
										 Click="OnPlayPauseClick" />

					<!-- 播放中 → 显示"暂停"图标，点它暂停 -->
					<chroa:SVGIconButton Icon="/Icons/pause.svg"
										 ButtonShape="Circle" ButtonSize="48" IconSize="24"
										 IsVisible="{Binding ShowPauseIcon}"
										 Click="OnPlayPauseClick" />
				</StackPanel>

				<TextBlock Grid.Column="1" Classes="time" Text="{Binding PositionText}" />

				<!-- 进度条拖动区。必须给 Background="Transparent"：null 背景不参与命中测试。
				     指针交互（按下 / 拖动 / 松手 / 捕获丢失）由代码里的 DragBar 接管，接线见 MainWindow 构造函数。
				     它本身 20px 高（上下都好按），轨道在里面居中：默认 3px、悬停展开 6px。 -->
				<Border Grid.Column="2" x:Name="SeekArea" Classes="bar" Background="Transparent" Cursor="Hand">
					<Border x:Name="SeekTrack" Classes="barTrack">
						<Border x:Name="SeekFill" Classes="barFill" HorizontalAlignment="Left" />
					</Border>
				</Border>

				<TextBlock Grid.Column="3" Classes="time" Text="{Binding DurationText}" />

				<!-- 音量图标：点一下直接静音 / 取消静音。
				     同一格里两个按钮按状态显隐 —— 和播放/暂停一个套路，省掉动态换图标的绑定。 -->
				<chroa:SVGIconButton Grid.Column="4"
				                    Icon="/Icons/volume-2.svg"
				                    IsEnabled="{Binding CanAdjustVolume}"
				                    ButtonShape="Circle" ButtonSize="40" IconSize="20"
				                    VerticalAlignment="Center"
				                    IsVisible="{Binding ShowVolumeIcon}"
				                    Click="OnMuteClick" />

				<chroa:SVGIconButton Grid.Column="4"
				                    Icon="/Icons/volume-x.svg"
				                    IsEnabled="{Binding CanAdjustVolume}"
				                    ButtonShape="Circle" ButtonSize="40" IconSize="20"
				                    VerticalAlignment="Center"
				                    IsVisible="{Binding ShowMutedIcon}"
				                    Click="OnMuteClick" />

				<!-- 音量条：和进度条同一套外观与交互，只是比例的含义不同（0~100） -->
				<Border Grid.Column="5" x:Name="VolumeArea" Classes="bar" Width="90"
				        Classes.disabled="{Binding !CanAdjustVolume}"
				        Margin="12,0,0,0"
				        Background="Transparent" Cursor="Hand">
					<Border x:Name="VolumeTrack" Classes="barTrack">
						<Border x:Name="VolumeFill" Classes="barFill" HorizontalAlignment="Left" />
					</Border>
				</Border>
			</Grid>
		</Border>

		<!-- 四角缩放热区。必须给 Background="Transparent"：null 背景不参与命中测试。
		     放在最后 = z 序最高，压在视频和控制带之上。
		     Size 想调就改这四个 Width/Height。 -->
		<Border x:Name="GripTopLeft" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Left" VerticalAlignment="Top"
		        Cursor="TopLeftCorner" PointerPressed="OnResizeGripPressed" />
		<Border x:Name="GripTopRight" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Right" VerticalAlignment="Top"
		        Cursor="TopRightCorner" PointerPressed="OnResizeGripPressed" />
		<Border x:Name="GripBottomLeft" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Left" VerticalAlignment="Bottom"
		        Cursor="BottomLeftCorner" PointerPressed="OnResizeGripPressed" />
		<Border x:Name="GripBottomRight" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Right" VerticalAlignment="Bottom"
		        Cursor="BottomRightCorner" PointerPressed="OnResizeGripPressed" />
	</Grid>
</Window>
