<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:mpv="clr-namespace:HanumanInstitute.LibMpv.Avalonia;assembly=HanumanInstitute.LibMpv.Avalonia"
        xmlns:vm="clr-namespace:ChroaVideoPlayer.ViewModels"
        xmlns:chroa="clr-namespace:ChroaVideoPlayer.Controls"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="720"
        x:Class="ChroaVideoPlayer.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="ChroaVideoPlayer"
        Width="1280" Height="720"
        WindowDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="-1"
        CanResize="True"
        Background="#0A0A0B">
	<!-- 整窗都能拖动窗口：在手柄里靠"源元素是否有 Button 祖先"放行按钮，
	     靠 e.Handled 放行四角热区。视频区域按下去也会走这里。 -->
	<Grid x:Name="Root" Background="Transparent"
	      PointerPressed="OnRootPointerPressed"
	      DragDrop.AllowDrop="True"
	      DragDrop.DragOver="OnDragOver"
	      DragDrop.Drop="OnDrop">
		<Grid.Styles>
			<Style Selector="Border#Chrome">
				<Setter Property="Opacity" Value="0" />
				<Setter Property="Transitions">
					<Transitions>
						<DoubleTransition Property="Opacity" Duration="0:0:0.18" />
					</Transitions>
				</Setter>
			</Style>
			<!-- 底部控制条：鼠标进入底部热区才淡入 -->
			<Style Selector="Border#Controls">
				<Setter Property="Opacity" Value="0" />
				<Setter Property="Transitions">
					<Transitions>
						<DoubleTransition Property="Opacity" Duration="0:0:0.18" />
					</Transitions>
				</Setter>
			</Style>
			<Style Selector="Border#BottomHotZone:pointerover Border#Controls">
				<Setter Property="Opacity" Value="1" />
			</Style>
			<Style Selector="Grid#Root:pointerover Border#Chrome">
				<Setter Property="Opacity" Value="1" />
			</Style>
		</Grid.Styles>

		<mpv:MpvView MpvContext="{Binding Mpv.ViewContext}" Renderer="OpenGl" />

		<!-- 控制带：刻意不使用 WindowDecorationProperties.ElementRole。
		     那套机制会把整条区域变成 Windows 的非客户区（标题栏），导致：
		       · Avalonia 的指针悬停追踪失效 → 整条把自己淡出成隐形，按钮点不到
		       · 光标归属权交给 OS → 永远是箭头，Cursor="Hand" 无效
		     所以拖动与双击最大化改为自己实现，见 MainWindow.axaml.cs。 -->
		<Border x:Name="Chrome" VerticalAlignment="Top" Background="Transparent"
		        DoubleTapped="OnChromeDoubleTapped">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
				<chroa:SVGIconButton Icon="M5 12h14"
									 ButtonShape="Square"
									 ButtonSize="48"
									 IconSize="24"
									 Click="OnMinimizeClick" />

				<chroa:SVGIconButton Icon="M5 3h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z"
									 ButtonSize="48"
									 IconSize="24"
									 ButtonShape="Square"
									 Click="OnMaximizeClick" />

				<chroa:SVGIconButton Icon="M18 6 6 18 M6 6 18 18"
									 ButtonSize="48"
									 IconSize="24"
									 ButtonShape="Square"
									 Click="OnCloseClick" />
			</StackPanel>
		</Border>

		<Border x:Name="BottomHotZone" VerticalAlignment="Bottom" Height="120" Background="Transparent">
			<Border x:Name="Controls" VerticalAlignment="Bottom" HorizontalAlignment="Center"
			        Margin="0,0,0,28">
				<StackPanel Orientation="Horizontal">
					<!-- 暂停中 → 显示"播放"图标，点它继续 -->
					<chroa:SVGIconButton Icon="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"
										 ButtonShape="Circle" ButtonSize="48" IconSize="24"
										 IsVisible="{Binding IsPaused}"
										 Click="OnPlayPauseClick" />

					<!-- 播放中 → 显示"暂停"图标，点它暂停 -->
					<chroa:SVGIconButton Icon="M6 3h3a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z M15 3h3a1 1 0 0 1 1 1v16a1 1 0 0 1-1 1h-3a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"
										 ButtonShape="Circle" ButtonSize="48" IconSize="24"
										 IsVisible="{Binding !IsPaused}"
										 Click="OnPlayPauseClick" />
				</StackPanel>
			</Border>
		</Border>

		<!-- 四角缩放热区。必须给 Background="Transparent"：null 背景不参与命中测试
		     （本项目已经踩过这个坑）。放在最后 = z 序最高，压在视频和控制带之上。
		     Size 想调就改这四个 Width/Height。 -->
		<Border x:Name="GripTopLeft" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Left" VerticalAlignment="Top"
		        Cursor="TopLeftCorner" PointerPressed="OnResizeGripPressed" />
		<Border x:Name="GripTopRight" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Right" VerticalAlignment="Top"
		        Cursor="TopRightCorner" PointerPressed="OnResizeGripPressed" />
		<Border x:Name="GripBottomLeft" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Left" VerticalAlignment="Bottom"
		        Cursor="BottomLeftCorner" PointerPressed="OnResizeGripPressed" />
		<Border x:Name="GripBottomRight" Width="10" Height="10" Background="Transparent"
		        HorizontalAlignment="Right" VerticalAlignment="Bottom"
		        Cursor="BottomRightCorner" PointerPressed="OnResizeGripPressed" />
	</Grid>
</Window>