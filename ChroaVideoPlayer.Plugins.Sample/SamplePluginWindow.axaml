<chroa:PluginWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chroa="clr-namespace:ChroaVideoPlayer.Core.Plugin.UI;assembly=ChroaVideoPlayer.Core"
                    x:Class="ChroaVideoPlayer.Plugins.Sample.SamplePluginWindow"
                    Title="Sample"
                    Width="260"
                    Height="320"
                    InitialDockSide="Left">
	<StackPanel Margin="12" Spacing="8">
		<TextBlock Text="Sample" FontSize="16" Foreground="White" />
		<TextBlock Text="A minimal window provided as a starting point."
		           TextWrapping="Wrap"
		           Foreground="#AAFFFFFF" />
		<TextBlock x:Name="LastPlayed"
		           Text="Nothing played yet"
		           TextTrimming="CharacterEllipsis"
		           Foreground="#AAFFFFFF" />
		<Button Content="Close"
		        HorizontalAlignment="Left"
		        Click="OnCloseClick" />
	</StackPanel>
</chroa:PluginWindow>
