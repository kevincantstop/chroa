<chroa:PluginWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:chroa="clr-namespace:ChroaVideoPlayer.Core.Plugin.UI;assembly=ChroaVideoPlayer.Core"
                    xmlns:core="clr-namespace:ChroaVideoPlayer.Core.UI;assembly=ChroaVideoPlayer.Core"
                    xmlns:sub="clr-namespace:ChroaVideoPlayer.Plugins.Subtitle"
                    x:Class="ChroaVideoPlayer.Plugins.Subtitle.SubtitleWindow"
                    x:DataType="sub:SubtitleWindowViewModel"
                    Title="Subtitle Editor"
                    Width="580"
                    Height="770"
                    MinWidth="530"
                    MinHeight="700"
                    InitialDockSide="Right">
	<chroa:PluginWindow.Styles>
		<StyleInclude Source="avares://ChroaVideoPlayer.Plugins.Subtitle/Styles/SubtitleWindow.axaml" />
	</chroa:PluginWindow.Styles>

	<Grid Margin="12" RowDefinitions="Auto,Auto,*">
		<Grid ColumnDefinitions="*,Auto">
			<TextBlock Text="Subtitles"
			           FontSize="16"
			           Foreground="White"
			           VerticalAlignment="Center" />

			<core:SVGIconButton Grid.Column="1"
			                    Icon="avares://ChroaVideoPlayer.Plugins.Subtitle/Icons/x.svg"
			                    ButtonSize="32"
			                    IconSize="16"
			                    HorizontalAlignment="Right"
			                    VerticalAlignment="Center"
			                    Click="OnCloseClick"
			                    ToolTip.Tip="Close" />
		</Grid>

		<StackPanel Grid.Row="1"
		            Orientation="Horizontal"
		            Spacing="8"
		            Margin="0,12,0,10">
			<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Subtitle/Icons/plus.svg"
			                    ButtonSize="32"
			                    IconSize="20"
			                    VerticalAlignment="Center"
			                    IsEnabled="{Binding CanCompose}"
			                    Click="OnAddSubtitleClick"
			                    ToolTip.Tip="Add subtitle file" />

			<core:SVGIconButton Icon="avares://ChroaVideoPlayer.Plugins.Subtitle/Icons/layers.svg"
			                    ButtonSize="32"
			                    IconSize="20"
			                    VerticalAlignment="Center"
			                    IsEnabled="{Binding CanCompose}"
			                    Click="OnComposeClick"
			                    ToolTip.Tip="Compose added subtitles into one track" />

			<ProgressBar Width="120"
			             Height="4"
			             IsIndeterminate="True"
			             VerticalAlignment="Center"
			             IsVisible="{Binding IsComposing}" />

			<TextBlock Text="{Binding ComposeStatus}"
			           FontSize="12"
			           Foreground="#B0FFFFFF"
			           VerticalAlignment="Center"
			           IsVisible="{Binding IsComposing}" />
		</StackPanel>

		<Grid Grid.Row="2">
			<sub:SubtitleGrid />

			<TextBlock x:Name="EmptyHint"
			           Text="No subtitle tracks."
			           FontSize="14"
			           Foreground="#B0FFFFFF"
			           Margin="8,44,0,0"
			           HorizontalAlignment="Left"
			           VerticalAlignment="Top"
			           IsVisible="{Binding IsEmpty}" />
		</Grid>
	</Grid>
</chroa:PluginWindow>
