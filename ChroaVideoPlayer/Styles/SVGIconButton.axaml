<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:ChroaVideoPlayer.Core.UI;assembly=ChroaVideoPlayer.Core">

	<Style Selector="core|SVGIconButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="#E0E0E0" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>

	<Style Selector="core|SVGIconButton:pointerover">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>
	<Style Selector="core|SVGIconButton:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>

	<Style Selector="core|SVGIconButton:pressed">
		<Setter Property="Background" Value="#66FFFFFF" />
	</Style>
	<Style Selector="core|SVGIconButton:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="#66FFFFFF" />
	</Style>
	<Style Selector="core|SVGIconButton:disabled">
		<Setter Property="Foreground" Value="#55FFFFFF" />
	</Style>
</Styles>
