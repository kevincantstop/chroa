<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.2</Version>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\appicon-black.ico')">Assets\appicon-black.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ChroaVideoPlayer.Core\ChroaVideoPlayer.Core.csproj" />
    <ProjectReference Include="..\ChroaVideoPlayer.Plugins.Playlist\ChroaVideoPlayer.Plugins.Playlist.csproj" ReferenceOutputAssembly="false" Private="false" IsPlugin="true" />
    <ProjectReference Include="..\ChroaVideoPlayer.Plugins.Sample\ChroaVideoPlayer.Plugins.Sample.csproj" ReferenceOutputAssembly="false" Private="false" IsPlugin="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="HanumanInstitute.LibMpv.Avalonia" Version="0.10.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="native\libmpv-2.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Icons\**" />
    <AvaloniaResource Include="Assets\**" Exclude="Assets\*.ico" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Settings\" />
  </ItemGroup>

  <Target Name="CopyPlugins" AfterTargets="Build">
    <MSBuild Projects="@(ProjectReference-&gt;WithMetadataValue('IsPlugin', 'true'))"
             Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier;SelfContained;RuntimeIdentifiers">
      <Output TaskParameter="TargetOutputs" ItemName="PluginAssemblies" />
    </MSBuild>
    <Copy SourceFiles="@(PluginAssemblies)" DestinationFolder="$(OutDir)Plugins" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyPluginsToPublish" AfterTargets="Publish" DependsOnTargets="CopyPlugins">
    <Copy SourceFiles="@(PluginAssemblies)" DestinationFolder="$(PublishDir)Plugins" SkipUnchangedFiles="true" />
  </Target>
</Project>
