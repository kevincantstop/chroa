<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ChroaVideoPlayer.ViewModels"
             xmlns:chroa="clr-namespace:ChroaVideoPlayer.Controls"
             xmlns:core="clr-namespace:ChroaVideoPlayer.Core.UI;assembly=ChroaVideoPlayer.Core"
             x:Class="ChroaVideoPlayer.Controls.HomeMenu"
             x:DataType="vm:MainViewModel">
	<Grid>
		<Border Classes="overlay"
		        HorizontalAlignment="Left"
		        VerticalAlignment="Top">
			<core:SVGIconButton Icon="/Icons/house.svg"
			                     ButtonShape="Square"
			                     ButtonSize="48"
			                     IconSize="24"
			                     Click="OnMenuButtonClick" />
		</Border>

		<Border Classes="overlay subtitleMenu"
		        HorizontalAlignment="Left"
		        VerticalAlignment="Top"
		        Margin="12,52,0,0"
		        IsVisible="{Binding Player.IsHomeMenuOpen}">
			<StackPanel>
				<Button Classes="subtitleItem" Click="OnLoadVideoClick">
					<StackPanel Orientation="Horizontal" Spacing="8">
						<core:SvgIcon Icon="/Icons/film.svg"
						               IconSize="16"
						               Foreground="#E0E0E0"
						               VerticalAlignment="Center" />
						<TextBlock Classes="subtitleLabel" Text="Load Video" />
					</StackPanel>
				</Button>

				<Border Classes="subtitleSeparator" />

				<ItemsControl ItemsSource="{Binding Player.Plugins}">
					<ItemsControl.ItemTemplate>
						<DataTemplate x:DataType="vm:PluginItem">
							<Button Classes="subtitleItem" Click="OnPluginClick">
								<Grid ColumnDefinitions="*,14">
									<StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
										<core:SvgIcon Icon="{Binding Icon}"
										               IconSize="16"
										               Foreground="#E0E0E0"
										               VerticalAlignment="Center" />
										<TextBlock Classes="subtitleLabel" Text="{Binding Label}" />
									</StackPanel>
									<Border Grid.Column="1" Classes="subtitleDot" IsVisible="{Binding IsOpen}" />
								</Grid>
							</Button>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</StackPanel>
		</Border>
	</Grid>
</UserControl>
