<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ChroaVideoPlayer.Controls">

	<!-- 常态：透明、无边框、无 margin。
	     VerticalAlignment 用 Top 而不是 Center：万一按钮比控制条高，
	     往视频方向溢出（可见）比被窗口上边缘裁掉（不可见）安全。 -->
	<Style Selector="controls|SVGIconButton">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="Foreground" Value="#E0E0E0" />
		<Setter Property="VerticalAlignment" Value="Top" />
	</Style>

	<!-- 悬停：半透明灰底（改这两个值即可调色） -->
	<Style Selector="controls|SVGIconButton:pointerover">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>
	<Style Selector="controls|SVGIconButton:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>

	<!-- 按下：比悬停稍深 -->
	<Style Selector="controls|SVGIconButton:pressed">
		<Setter Property="Background" Value="#66FFFFFF" />
	</Style>
	<Style Selector="controls|SVGIconButton:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="#66FFFFFF" />
	</Style>
</Styles>