<Styles xmlns="https://github.com/avaloniaui">

	<Style Selector="TextBlock.time">
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="Margin" Value="12,0" />
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="#C8C8C8" />
	</Style>

	<Style Selector="Border.bar">
		<Setter Property="Height" Value="20" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="Border.barTrack">
		<Setter Property="Height" Value="3" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="CornerRadius" Value="2" />
		<Setter Property="Background" Value="#33FFFFFF" />
		<Setter Property="Transitions">
			<Transitions>
				<DoubleTransition Property="Height" Duration="0:0:0.12" />
			</Transitions>
		</Setter>
	</Style>

	<Style Selector="Border.bar:pointerover Border.barTrack">
		<Setter Property="Height" Value="6" />
	</Style>

	<Style Selector="Border.barFill">
		<Setter Property="CornerRadius" Value="2" />
		<Setter Property="Background" Value="#F0F0F0" />
	</Style>

	<Style Selector="Border.subtitleMenu">
		<Setter Property="Background" Value="#1A1A1A" />
		<Setter Property="CornerRadius" Value="10" />
		<Setter Property="Padding" Value="6" />
		<Setter Property="Margin" Value="0,0,24,10" />
		<Setter Property="MinWidth" Value="200" />
		<Setter Property="MaxWidth" Value="320" />
	</Style>

	<Style Selector="Button.subtitleItem">
		<Setter Property="Background" Value="Transparent" />
		<Setter Property="Foreground" Value="#E0E0E0" />
		<Setter Property="BorderThickness" Value="0" />
		<Setter Property="CornerRadius" Value="6" />
		<Setter Property="Padding" Value="8,6" />
		<Setter Property="HorizontalAlignment" Value="Stretch" />
		<Setter Property="HorizontalContentAlignment" Value="Stretch" />
		<Setter Property="Cursor" Value="Hand" />
	</Style>

	<Style Selector="Button.subtitleItem:pointerover">
		<Setter Property="Background" Value="#26FFFFFF" />
	</Style>
	<Style Selector="Button.subtitleItem:pointerover /template/ ContentPresenter">
		<Setter Property="Background" Value="#26FFFFFF" />
	</Style>

	<Style Selector="Button.subtitleItem:pressed">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>
	<Style Selector="Button.subtitleItem:pressed /template/ ContentPresenter">
		<Setter Property="Background" Value="#40FFFFFF" />
	</Style>

	<Style Selector="TextBlock.subtitleLabel">
		<Setter Property="FontSize" Value="13" />
		<Setter Property="Foreground" Value="#E0E0E0" />
		<Setter Property="VerticalAlignment" Value="Center" />
		<Setter Property="TextTrimming" Value="CharacterEllipsis" />
	</Style>

	<Style Selector="TextBlock.subtitleHint">
		<Setter Property="FontSize" Value="12" />
		<Setter Property="Foreground" Value="#808080" />
		<Setter Property="Margin" Value="8,6" />
	</Style>

	<Style Selector="Border.subtitleDot">
		<Setter Property="Width" Value="6" />
		<Setter Property="Height" Value="6" />
		<Setter Property="CornerRadius" Value="3" />
		<Setter Property="Background" Value="#F0F0F0" />
		<Setter Property="HorizontalAlignment" Value="Left" />
		<Setter Property="VerticalAlignment" Value="Center" />
	</Style>

	<Style Selector="Border.subtitleSeparator">
		<Setter Property="Height" Value="1" />
		<Setter Property="Background" Value="#26FFFFFF" />
		<Setter Property="Margin" Value="8,4" />
	</Style>
</Styles>
